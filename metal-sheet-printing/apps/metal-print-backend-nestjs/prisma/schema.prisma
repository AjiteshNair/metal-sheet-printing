generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// USER & ADDRESS MANAGEMENT
// ==========================================
// OAuth-only — no passwords stored. A user is created on first successful
// Google/Facebook login, holding just what that flow gives us: name + email.

model User {
  id         Int          @id @default(autoincrement())
  email      String       @unique
  name       String
  provider   AuthProvider
  providerId String
  role       Role         @default(CUSTOMER)
  createdAt  DateTime     @default(now())
  isActive   Boolean      @default(true)

  addresses Address[]
  carts     Cart[]
  orders    Order[]

  @@unique([provider, providerId])
  @@map("user")
}

enum AuthProvider {
  GOOGLE
  FACEBOOK
}

enum Role {
  CUSTOMER
  ADMIN
}

model Address {
  id        Int      @id @default(autoincrement())
  uid       Int
  label     String
  fullName  String
  line1     String
  line2     String?
  city      String
  state     String
  pincode   String
  phone     String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [uid], references: [id], onDelete: Cascade)

  @@map("address")
}

// ==========================================
// PRODUCT CATALOG & MEDIA
// ==========================================
// Single flat price — glossy is the only finish sold, so there's nothing
// to vary price by. No variant table needed.

model Product {
  id       Int         @id @default(autoincrement())
  name     String
  desc     String      @db.Text
  price    Decimal     @db.Decimal(10, 2)
  type     ProductType @default(STANDARD)
  isActive Boolean     @default(true)

  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@map("product")
}

model ProductImage {
  id         Int    @id @default(autoincrement())
  pid        Int
  imgurl     String
  sortWeight Int    @default(0)

  product Product @relation(fields: [pid], references: [id], onDelete: Cascade)

  @@map("product_images")
}

enum ProductType {
  STANDARD
  CUSTOMIZABLE
}

// ==========================================
// CUSTOM PRINTS
// ==========================================
// Created standalone at upload time, before it's attached to a cart or
// order. Cropping happens client-side (the user repositions/zooms within
// the A4 slot in the browser); only the final chosen framing is ever
// uploaded and stored here — never the original plus coordinates.

model CustomPrint {
  id            Int       @id @default(autoincrement())
  imageUrl      String
  dimensions    String    @default("A4")
  dpiStatus     DpiStatus @default(PENDING)
  dpiValue      Int?
  failureReason String?
  createdAt     DateTime  @default(now())

  cartItem  CartItem?
  orderItem OrderItem?

  @@map("custom_print")
}

enum DpiStatus {
  PENDING
  PASSED
  FAILED
}

// ==========================================
// CART (pre-checkout, guest-accessible)
// ==========================================
// Browsing and adding to cart never require login. uid is only set once
// the person signs in — which becomes mandatory before completing checkout.

model Cart {
  id           Int      @id @default(autoincrement())
  uid          Int?
  sessionToken String   @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User?      @relation(fields: [uid], references: [id], onDelete: SetNull)
  items CartItem[]

  @@map("cart")
}

model CartItem {
  id            Int      @id @default(autoincrement())
  cartId        Int
  productId     Int?
  customPrintId Int?     @unique
  quantity      Int      @default(1)
  unitPrice     Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())

  cart        Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product     Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)
  customPrint CustomPrint? @relation(fields: [customPrintId], references: [id], onDelete: Restrict)

  @@map("cart_item")
}

// ==========================================
// ORDER & FULFILLMENT
// ==========================================
// uid is required — placing an order requires being signed in. Shipping is
// always free, so there's no separate shipping amount to track.

model Order {
  id             Int            @id @default(autoincrement())
  orderCode      String         @unique
  uid            Int
  address        Json
  coupon         String?
  status         OrderStatus    @default(PENDING)
  totalAmount    Decimal        @db.Decimal(10, 2)
  trackingNumber String?
  createdAt      DateTime       @default(now())
  paymentStatus  PaymentStatus? @default(UNPAID)

  razorpayOrderId   String?
  razorpayPaymentId String?

  user  User        @relation(fields: [uid], references: [id], onDelete: Restrict)
  items OrderItem[]

  @@map("order")
}

model OrderItem {
  id            Int     @id @default(autoincrement())
  oid           Int
  productId     Int?
  customPrintId Int?    @unique
  quantity      Int     @default(1)
  unitPrice     Decimal @db.Decimal(10, 2)

  order       Order        @relation(fields: [oid], references: [id], onDelete: Restrict)
  product     Product?     @relation(fields: [productId], references: [id], onDelete: Restrict)
  customPrint CustomPrint? @relation(fields: [customPrintId], references: [id], onDelete: Restrict)

  @@map("order_item")
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum OrderStatus {
  PENDING
  PROCESSING
  PRINTING
  SHIPPED
  DELIVERED
  CANCELLED
}
